{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Switch",
  "version": "3.0.0",
  "identifier": "com.biojiang8.codex-switch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Switch",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "ChatGPT 官方 / API 一键切换 + 清缓存刷新",
    "longDescription": "Codex Switch 桌面版：首次启动向导式配置，一键切换 ChatGPT 官方账户与任意 API Provider，清缓存刷新会话列表。API Key 存 macOS 钥匙串。",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
